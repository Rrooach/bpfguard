# BPF State Observer disposable x86 VM overlay.
#
# The raw-syscall recorder does not consume BTF. Disabling debug info keeps the
# acceptance kernel build independent of pahole and small enough for fast CI.
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set

# BPF_PRELOAD creates iterator Links before the test starts. Those Links are
# valid kernel state, but they make a supposedly clean fixture VM unsuitable
# as an endpoint baseline.
# CONFIG_BPF_PRELOAD is not set

# Boot the maintained Debian raw ext4 test image under QEMU and expose SSH.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_E1000=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_CONFIGFS_FS=y

# The exclusive-vm fixtures install a closed syscall policy before issuing
# their permitted BPF operations.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Keep the exact effective configuration available for extraction and policy
# hashing after the build.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_CGROUP_FREEZER=y
